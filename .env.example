# Copy to .env.local for local development. In production these are set
# directly in Vercel's Environment Variables for this project, never
# committed. None of these are prefixed NEXT_PUBLIC_, so none of them ever
# reach the browser bundle.

# Existing (scorecard email notifications). Optional locally - the
# scorecard still works without it, it just skips sending the email.
RESEND_API_KEY=

# Added for /board.

# Fine-grained GitHub personal access token, read-only, scoped to only the
# rossvincent/ClaudeOS repository's contents. Create at:
# GitHub -> Settings -> Developer settings -> Fine-grained tokens.
GITHUB_TOKEN=

# The password for /board/login. Make it a genuinely long passphrase
# (20+ characters) - checkPassword() in src/app/board/lib/password.ts
# refuses anything shorter, since a long passphrase plus the rate limiter
# is what stands in for heavier login-throttling infrastructure here.
BOARD_PASSWORD=

# Signs the /board session cookie. Generate once with:
#   openssl rand -base64 32
BOARD_SESSION_SECRET=
